# Copy this file to ".env" and fill in real values.
# ".env" should NEVER be committed to git — add it to .gitignore.

# OANDA (or your broker of choice)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice   # "practice" for demo/paper, "live" for real money

# AI model provider — only fill in the one you're using
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
